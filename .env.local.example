# ─── IA — al menos una clave es obligatoria ──────────────────────────────────
# Prioridad: Anthropic → Gemini → Groq (usa el primero que encuentre)

ANTHROPIC_API_KEY=sk-ant-...        # console.anthropic.com
GEMINI_API_KEY=                     # aistudio.google.com/apikey
GROQ_API_KEY=                       # console.groq.com/keys

# ─── Hardware cuántico real (opcional) ────────────────────────────────────────
# Sin estas variables el sistema usa simulación local (instantánea).

# IBM Quantum — cloud.ibm.com → tu instancia IBM Quantum → Credenciales
IBM_QUANTUM_TOKEN=                  # API key de IBM Cloud IAM
IBM_QUANTUM_CRN=crn:v1:bluemix:...  # CRN de tu instancia IBM Quantum

# Nombres de backend IBM (opcionales, hay valores por defecto)
# IBM_SIM_BACKEND=ibmq_qasm_simulator
# IBM_REAL_BACKEND=ibm_sherbrooke

# IonQ — cloud.ionq.com/settings/api-keys
IONQ_API_KEY=                       # API key de IonQ

# QPU real de IonQ (opcional, por defecto: qpu.aria-1)
# IONQ_REAL_TARGET=qpu.aria-1

# ─── Zotero (opcional) ────────────────────────────────────────────────────────
# Para sincronizar tu biblioteca de papers de Zotero Cloud
# ZOTERO_USER_ID=
# ZOTERO_API_KEY=
